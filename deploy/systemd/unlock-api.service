[Unit]
Description=UnLock billing/admin API (FastAPI, uvicorn)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/vpn-bot
Environment=DATABASE_URL=postgresql+asyncpg://vpn_bot:vpn_bot_password@127.0.0.1:5432/vpn_bot
# Bind loopback only — Caddy fronts this on 127.0.0.1:8080 with TLS. Never expose
# the billing/admin API directly on a public interface (plaintext + extra surface).
ExecStart=/opt/vpn-bot/.venv/bin/uvicorn services.http_api:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
StandardOutput=append:/var/log/unlock-api.log
StandardError=append:/var/log/unlock-api.log

[Install]
WantedBy=multi-user.target
