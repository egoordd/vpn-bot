[Unit]
Description=Avangard GT Telegram bot (free trial, no payments)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/vpn-bot
EnvironmentFile=/etc/avangard-bot.env
ExecStart=/opt/vpn-bot/.venv/bin/python -m marat_bot.app
User=unlockapp
Restart=always
RestartSec=5
StateDirectory=avangard-bot
StateDirectoryMode=0750
Environment=MARAT_DB=/var/lib/avangard-bot/users.sqlite3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

[Install]
WantedBy=multi-user.target
