# Public site origin (used for canonical URLs / metadata).
NEXT_PUBLIC_SITE_URL=https://unlock.example

# Telegram bot username for the Login Widget and deep links (no @).
NEXT_PUBLIC_TELEGRAM_BOT=unlock_bot

# Shared billing API (Python services/billing_api.py exposed over HTTP).
# When unset, the site serves deterministic mock data so the UI runs standalone.
BILLING_API_URL=
BILLING_API_TOKEN=
