# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:replace_with_bot_token

# CryptoBot payments
CRYPTOBOT_TOKEN=replace_with_cryptobot_token
CRYPTOBOT_API_URL=https://pay.crypt.bot/api
CRYPTOBOT_POLL_INTERVAL=30

# YooKassa card payments (API + webhook). Keys from the merchant panel.
# Leave SHOP_ID/SECRET_KEY empty to keep the card button hidden.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
# Telegram deep link the buyer returns to after paying, e.g. https://t.me/unlkvpn_bot
YOOKASSA_RETURN_URL=
# 54-ФЗ receipts (самозанятый). Set ENABLED=true and a contact email to issue чеки.
YOOKASSA_RECEIPT_ENABLED=false
YOOKASSA_RECEIPT_EMAIL=

# Panel provider used for user provisioning and traffic sync: remnawave or marzban.
PANEL_PROVIDER=remnawave

# Remnawave panel API (primary provisioning path)
REMNAWAVE_API_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=replace_with_remnawave_api_token
REMNAWAVE_USERNAME_PREFIX=tg
REMNAWAVE_DEFAULT_TRAFFIC_RESET_STRATEGY=NO_RESET
REMNAWAVE_DEFAULT_INTERNAL_SQUAD_UUIDS=replace_with_default_internal_squad_uuid
REMNAWAVE_NODE_CONFIG_PROFILE_UUID=replace_with_config_profile_uuid
REMNAWAVE_NODE_INBOUND_UUIDS=replace_with_inbound_uuid
REMNAWAVE_NODE_PORT=2222
REMNAWAVE_HOST_PORT=1234
REMNAWAVE_HOST_TAG=AUTO
REMNAWAVE_NODE_COUNTRY_CODE=XX
REMNAWAVE_NODE_TRAFFIC_TRACKING=false
# Optional manual/single-server node registration values for scripts/register_static_node.py.
REMNAWAVE_STATIC_NODE_IP=
REMNAWAVE_STATIC_PANEL_NODE_ID=
REMNAWAVE_STATIC_NODE_REGION=ams
REMNAWAVE_STATIC_NODE_CAPACITY=50
REMNAWAVE_STATIC_NODE_NAME=manual-remnawave-node

# Optional Marzban panel API (for Marzban smoke or future provider switch).
MARZBAN_API_URL=
MARZBAN_ACCESS_TOKEN=
# If access token is empty, client can request one with admin username/password.
MARZBAN_USERNAME=
MARZBAN_PASSWORD=
MARZBAN_USERNAME_PREFIX=tg
# JSON copied from Marzban inbound/proxy settings for new users.
MARZBAN_DEFAULT_PROXIES={}
# Standard users get ALL these inbounds (multi-location, switch in client).
MARZBAN_DEFAULT_INBOUNDS={}
# Per-region inbounds for static premium nodes (region -> inbounds).
MARZBAN_REGION_INBOUNDS={}
MARZBAN_DATA_LIMIT_RESET_STRATEGY=no_reset

# Vultr autoscaler API
VULTR_API_URL=https://api.vultr.com/v2
VULTR_API_TOKEN=replace_with_vultr_api_token
VULTR_DEFAULT_REGION=ams
VULTR_DEFAULT_PLAN=vc2-1c-1gb
# Check the current Ubuntu 24.04 OS id with GET https://api.vultr.com/v2/os.
VULTR_DEFAULT_OS_ID=0
VULTR_SSH_KEY_IDS=
VULTR_NODE_CAPACITY=50
VULTR_NODE_LABEL_PREFIX=unlock
AUTOSCALE_CHECK_INTERVAL_SECONDS=300
# Empty means scheduler will not warm-provision premium nodes automatically.
AUTOSCALE_PREMIUM_REGIONS=
AUTOSCALE_PREMIUM_MIN_FREE_SLOTS=1
AUTOSCALE_PREMIUM_MIN_ACTIVE_NODES=0
AUTOSCALE_MAX_PROVISIONS_PER_REGION=1
AUTOSCALE_DECOMMISSION_EMPTY=true

# Services from docker-compose.yml.
# Use service hostnames for the default compose network.
DATABASE_URL=postgresql+asyncpg://vpn_bot:vpn_bot_password@postgres:5432/vpn_bot
REDIS_URL=redis://redis:6379/0

# Legacy AmneziaWG/WireGuard fallback settings.
# The default Remnawave path does not require privileged WireGuard access.
WG_CONFIG_PATH=/etc/wireguard/clients
WG_INTERFACE=awg0
WG_SERVER_PUBLIC_KEY=<awg server pubkey>
WG_SERVER_ENDPOINT=<ip>:51821
WG_CLIENT_DNS=1.1.1.1
WG_ALLOWED_IPS=0.0.0.0/0
WG_CLIENT_ADDRESS_POOL=10.9.0.0/24
AWG_JC=4
AWG_JMIN=40
AWG_JMAX=70
AWG_S1=50
AWG_S2=100
AWG_H1=1234567
AWG_H2=2345678
AWG_H3=3456789
AWG_H4=4567890

# Bot metadata
SUPPORT_USERNAME=your_support_username
ADMIN_IDS=123456789,987654321
DB_ECHO=false

# PostgreSQL container settings
POSTGRES_DB=vpn_bot
POSTGRES_USER=vpn_bot
POSTGRES_PASSWORD=vpn_bot_password
