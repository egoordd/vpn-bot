# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:replace_with_bot_token

# CryptoBot payments
CRYPTOBOT_TOKEN=replace_with_cryptobot_token
CRYPTOBOT_API_URL=https://pay.crypt.bot/api
CRYPTOBOT_POLL_INTERVAL=30

# Services from docker-compose.yml
DATABASE_URL=postgresql+asyncpg://vpn_bot:vpn_bot_password@postgres:5432/vpn_bot
REDIS_URL=redis://redis:6379/0

# WireGuard server settings
WG_CONFIG_PATH=/etc/wireguard/clients
WG_INTERFACE=awg0
WG_SERVER_PUBLIC_KEY=<awg server pubkey>
WG_SERVER_ENDPOINT=<ip>:51821
WG_CLIENT_DNS=1.1.1.1
WG_ALLOWED_IPS=0.0.0.0/0
WG_CLIENT_ADDRESS_POOL=10.9.0.0/24
AWG_JC=4
AWG_JMIN=40
AWG_JMAX=70
AWG_S1=50
AWG_S2=100
AWG_H1=1234567
AWG_H2=2345678
AWG_H3=3456789
AWG_H4=4567890

# Bot metadata
SUPPORT_USERNAME=your_support_username
ADMIN_IDS=123456789,987654321
DB_ECHO=false

# PostgreSQL container settings
POSTGRES_DB=vpn_bot
POSTGRES_USER=vpn_bot
POSTGRES_PASSWORD=vpn_bot_password
